<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The widget's own surface tokens, on the Material 3 baseline roles, so the launcher
      surface and the companion app read as one product. Android 12+ repoints these at the
      device's tonal scheme in values-v31/colors.xml.

      These are the *chrome* the publisher's content sits on. The publisher-facing palette
      (Typo.kt and layout.schema.json) is a separate, closed contract and is deliberately
      not touched here; ContrastTest checks that its SECONDARY still clears 4.5:1 on these
      surfaces.
    -->
    <color name="widget_surface">#FEF7FF</color>
    <color name="widget_on_surface">#1D1B20</color>
    <color name="widget_secondary">#49454F</color>
    <color name="widget_accent">#6750A4</color>
    <color name="widget_on_accent">#FFFFFF</color>
    <color name="widget_hairline">#CAC4D0</color>

    <!-- Status dot: the contract's AA-on-surface semantics, so widget and app agree. -->
    <color name="widget_status_fresh">#1E7D3C</color>
    <color name="widget_status_aged">#8A5A00</color>
    <color name="widget_status_stale">#B3261E</color>
    <color name="widget_status_offline">#49454F</color>

    <!--
      Forced dark: used when a publication sets dark_palette, which is an author decision
      rather than a device one, so these are explicit rather than resolved from the
      device's night qualifier. M3 dark container roles.
    -->
    <color name="widget_surface_dark">#211F26</color>
    <color name="widget_on_surface_dark">#E6E0E9</color>
    <color name="widget_secondary_dark">#CAC4D0</color>
    <color name="widget_accent_dark">#D0BCFF</color>
    <color name="widget_on_accent_dark">#381E72</color>
    <color name="widget_hairline_dark">#49454F</color>
</resources>

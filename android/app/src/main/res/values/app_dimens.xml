<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Spacing: the MD3 spacing scale, one name per step (4 / 8 / 16 / 24). The screens use
      these directly; there used to be a second name for 16dp (`gutter`), and two names
      for one step is how a layout ends up half on one scale and half on the other.
    -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>

    <!--
      Shape: the Material 3 corner radius scale, by name.
      Material uses a size-based scale, and each component takes a step from it: a pill for
      anything pressed, `medium` for fields and small chips, `large` for cards and dialogs,
      `extra large` for the widget root and full-screen surfaces.
    -->
    <dimen name="shape_xs">4dp</dimen>
    <dimen name="shape_sm">8dp</dimen>
    <dimen name="shape_md">12dp</dimen>
    <dimen name="shape_lg">16dp</dimen>
    <dimen name="shape_xl">28dp</dimen>
    <dimen name="shape_full">9999dp</dimen>

    <!-- Named component steps, so a layout never invents a radius. -->
    <dimen name="shape_button">@dimen/shape_full</dimen>
    <dimen name="shape_container">@dimen/shape_lg</dimen>
    <dimen name="shape_field">@dimen/shape_md</dimen>

    <dimen name="hairline">1dp</dimen>

    <!--
      M3's button is a 40dp visual height; the platform's minimum touch target is 48dp. The
      visual height follows the spec's rhythm and the touch target keeps the accessibility
      floor, which is why this is not simply 40.
    -->
    <dimen name="touch_target">48dp</dimen>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Companion-surface tokens, light.

      Adopted from the Material 3 tonal-palette design system, narrowed to what this app
      actually has: four screens, no receipts, chips, switches or steppers. The dark set
      (values-night) is the canonical one; this file keeps the light side of the same
      tonal ladder, because a phone in light mode must stay readable.

      Elevation is tonal, never a drop shadow: surface -> container -> container-high.
      Every ink pair below is asserted at >= 4.5:1 by ContrastTest.
    -->
    <color name="app_surface">#F7F2FF</color>
    <color name="app_surface_container">#F1EBF9</color>
    <color name="app_surface_container_high">#E7E0F2</color>
    <color name="app_on_surface">#1B1B1F</color>
    <color name="app_on_surface_variant">#5F5F66</color>
    <color name="app_primary">#5B3CC4</color>
    <color name="app_on_primary">#FFFFFF</color>
    <color name="app_primary_container">#E7DEFF</color>
    <color name="app_on_primary_container">#2A1373</color>
    <color name="app_outline">#8E86A6</color>
    <color name="app_outline_variant">#DDD6EC</color>
    <!-- Press/hover overlay. A button without a state layer gives no feedback at all,
         and a tap then reads as a dead control. -->
    <color name="app_state_layer">#1F1B1B1F</color>
    <color name="paired_indicator">#1E7D3C</color>
    <color name="unpaired_indicator">#5F5F66</color>
</resources>

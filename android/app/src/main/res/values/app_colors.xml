<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 baseline colour roles, light scheme.

  Values are the official M3 baseline system tokens (m3.material.io/styles/color/
  static/baseline), with the reference tone each one comes from, so a future reviewer
  can check a value against the spec instead of trusting a screenshot. The surfaces are the
  `surfaceContainer*` family, which replaced elevation overlays: depth is tone, not shadow.

  Android 12+ overrides these with the wallpaper-derived (dynamic) scheme in
  values-v31/app_colors.xml, exactly as the platform's own Material You mapping does.
-->
<resources>
    <!-- Surfaces: neutral 98 / 100 / 96 / 94 / 92 / 90 -->
    <color name="app_surface">#FEF7FF</color>
    <color name="app_surface_container_lowest">#FFFFFF</color>
    <color name="app_surface_container_low">#F7F2FA</color>
    <color name="app_surface_container">#F3EDF7</color>
    <color name="app_surface_container_high">#ECE6F0</color>
    <color name="app_surface_container_highest">#E6E0E9</color>
    <color name="app_surface_dim">#DED8E1</color>
    <color name="app_surface_bright">#FEF7FF</color>
    <color name="app_surface_variant">#E7E0EC</color>

    <!-- Ink: on-surface neutral 10, on-surface-variant neutral-variant 30 -->
    <color name="app_on_surface">#1D1B20</color>
    <color name="app_on_surface_variant">#49454F</color>

    <!-- Brand: primary 40, on-primary 100, primary-container 90, on-container 10 -->
    <color name="app_primary">#6750A4</color>
    <color name="app_on_primary">#FFFFFF</color>
    <color name="app_primary_container">#EADDFF</color>
    <color name="app_on_primary_container">#21005D</color>

    <!--
      Secondary 40/100/90/30 and tertiary 40/100/90/30. These were missing while every
      control was hand-drawn from primary tokens; Theme.Material3 resolves them for every
      MD3 component that is not a filled/tonal button (assist chips, tonal surfaces,
      switches, dialog accents), and an unmapped role silently falls back to the library's
      default purple rather than to Hermes' own palette. Same reference tones as primary,
      so they can be checked against the spec the same way.
    -->
    <color name="app_secondary">#625B71</color>
    <color name="app_on_secondary">#FFFFFF</color>
    <color name="app_secondary_container">#E8DEF8</color>
    <color name="app_on_secondary_container">#1D192B</color>

    <color name="app_tertiary">#7D5260</color>
    <color name="app_on_tertiary">#FFFFFF</color>
    <color name="app_tertiary_container">#FFD8E4</color>
    <color name="app_on_tertiary_container">#31111D</color>

    <!-- Status: error 40, on-error 100, error-container 90, on-error-container 30 -->
    <color name="app_error">#B3261E</color>
    <color name="app_on_error">#FFFFFF</color>
    <color name="app_error_container">#F9DEDC</color>
    <color name="app_on_error_container">#410E0B</color>

    <!--
      Inverse roles: the pair a snackbar is painted in (inverse-surface n20 with
      inverse-on-surface n95), plus the accent that stays legible on it. MD3 keeps these
      separate from the normal surface roles precisely so a snackbar is never "surface,
      but darker", which is what makes it float over the content.
    -->
    <color name="app_inverse_surface">#322F35</color>
    <color name="app_inverse_on_surface">#F5EFF7</color>
    <color name="app_inverse_primary">#D0BCFF</color>

    <!-- Outline: neutral-variant 50 / 80 -->
    <color name="app_outline">#79747E</color>
    <color name="app_outline_variant">#CAC4D0</color>

    <!--
      State layers: the component's *own* foreground at the M3 opacities
      (hover 8%, focus 10%, pressed 10%, dragged 16%). Using on-surface on every control
      was wrong: the layer sits on the control's fill, so it takes that control's ink.
    -->
    <color name="app_state_layer_filled">#7662AD</color>       <!-- onPrimary @ 10% -->
    <color name="app_state_layer_tonal">#DACCF3</color>        <!-- onPrimaryContainer @ 10% -->
    <color name="app_state_layer_outlined">#EFE6F6</color>     <!-- primary @ 10% on surface -->

    <!-- Pairing indicator. Hue is ours; the contract's AA-on-surface values are reused so
         the widget and the app cannot drift apart. -->
    <color name="paired_indicator">#1E7D3C</color>
    <color name="unpaired_indicator">#49454F</color>
</resources>

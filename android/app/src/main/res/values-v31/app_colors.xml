<?xml version="1.0" encoding="utf-8"?>
<!--
  Material You, light (Android 12+).

  The M3 baseline is the fallback; on a device with a wallpaper-derived scheme the
  platform's own tonal roles replace it, which is the whole point of dynamic colour
  ("the key part of Material You", developer.android.com M3 in Compose). Mapping follows the
  M3 dynamic scheme: surfaces from neutral1, secondary ink and outlines from neutral2, and
  the brand from accent1, at the tones M3 uses for each role in light mode.

  The app follows the device's theme like every other Android app; it does not force dark.
-->
<resources>
    <color name="app_surface">@android:color/system_neutral1_50</color>
    <color name="app_surface_container_lowest">@android:color/system_neutral1_0</color>
    <color name="app_surface_container_low">@android:color/system_neutral1_100</color>
    <color name="app_surface_container">@android:color/system_neutral1_100</color>
    <color name="app_surface_container_high">@android:color/system_neutral1_100</color>
    <color name="app_surface_container_highest">@android:color/system_neutral1_200</color>
    <color name="app_surface_dim">@android:color/system_neutral1_600</color>
    <color name="app_surface_bright">@android:color/system_neutral1_50</color>
    <color name="app_surface_variant">@android:color/system_neutral2_100</color>

    <color name="app_on_surface">@android:color/system_neutral1_900</color>
    <color name="app_on_surface_variant">@android:color/system_neutral2_600</color>

    <color name="app_primary">@android:color/system_accent1_400</color>
    <color name="app_on_primary">@android:color/system_accent1_100</color>
    <color name="app_primary_container">@android:color/system_accent1_900</color>
    <color name="app_on_primary_container">@android:color/system_accent1_100</color>

    <!-- accent2/accent3 take the secondary and tertiary roles. Left unmapped they would
         resolve to the library's static purple/pink, which is exactly the "app ignores
         the wallpaper" failure Material You is meant to remove. -->
    <color name="app_secondary">@android:color/system_accent2_400</color>
    <color name="app_on_secondary">@android:color/system_accent2_100</color>
    <color name="app_secondary_container">@android:color/system_accent2_900</color>
    <color name="app_on_secondary_container">@android:color/system_accent2_100</color>

    <color name="app_tertiary">@android:color/system_accent3_400</color>
    <color name="app_on_tertiary">@android:color/system_accent3_100</color>
    <color name="app_tertiary_container">@android:color/system_accent3_900</color>
    <color name="app_on_tertiary_container">@android:color/system_accent3_100</color>

    <!-- M3 derives error dynamically too, but the platform exposes an error ramp that
         does not form a legible on-error pair in both modes, so this one role stays on the
         baseline value rather than guessing a tone. -->
    <color name="app_error">#B3261E</color>
    <color name="app_on_error">#FFFFFF</color>
    <color name="app_error_container">#F9DEDC</color>
    <color name="app_on_error_container">#410E0B</color>

    <!-- A snackbar is the bright surface in a light scheme, so inverse-surface takes the
         dark end of neutral1 and its ink the light end. -->
    <color name="app_inverse_surface">@android:color/system_neutral1_800</color>
    <color name="app_inverse_on_surface">@android:color/system_neutral1_50</color>
    <color name="app_inverse_primary">@android:color/system_accent1_200</color>

    <color name="app_outline">@android:color/system_neutral2_500</color>
    <color name="app_outline_variant">@android:color/system_neutral2_200</color>

    <color name="app_state_layer_field">@android:color/system_neutral1_100</color>
</resources>

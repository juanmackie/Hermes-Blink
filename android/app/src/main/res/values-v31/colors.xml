<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : follow the device's own tonal palette (Material You) so the
         widget matches the launcher theme the user already chose. Tone 50/900/700 are
         the platform's light surface/ink/secondary pair and accent1_500 is the theme
         primary; the semantic success/danger pair stays ours because the platform
         palette has no green. Older releases fall back to values/colors.xml. -->
    <color name="widget_surface">@android:color/system_neutral1_50</color>
    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_secondary">@android:color/system_neutral1_700</color>
    <color name="widget_accent">@android:color/system_accent1_500</color>
    <color name="widget_on_accent">#FFFFFF</color>
    <color name="widget_hairline">@android:color/system_neutral1_200</color>
</resources>

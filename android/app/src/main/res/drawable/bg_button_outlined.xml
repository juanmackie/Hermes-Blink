<?xml version="1.0" encoding="utf-8"?>
<!--
  Outlined button: transparent fill inside a 1dp outline boundary, pill, state layer in
  primary over the surface it sits on.

  Kept as the fallback for a plain <Button>, with the same reason and the same gate as
  bg_button_tonal.xml: MaterialButton draws this itself now, and
  `check-contract-parity.py` fails if the ripple or the mask goes. The mask is the part
  that matters most here — without it the ripple spills outside the pill on a button whose
  fill is transparent.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources"
    android:color="@color/app_state_layer_outlined">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/shape_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/shape_button" />
            <stroke
                android:width="@dimen/hairline"
                android:color="@color/app_outline" />
        </shape>
    </item>
</ripple>

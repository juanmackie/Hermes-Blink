<?xml version="1.0" encoding="utf-8"?>
<!-- WS-2: the radius comes from the same dimen the widget resolves on API 31+ and from
     the same value the preview mirrors, so the picker preview and the live surface round
     the same way. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="@dimen/widget_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_hairline" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal elevation level 1: a container surface with a hairline outline-variant border,
     used instead of a drop shadow so the card reads on any wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/app_surface_container" />
    <corners android:radius="@dimen/shape_card" />
    <stroke
        android:width="@dimen/hairline"
        android:color="@color/app_outline_variant" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal button: primary-container fill, pill, with a press state. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/app_state_layer">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/shape_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_primary_container" />
            <corners android:radius="@dimen/shape_pill" />
        </shape>
    </item>
</ripple>

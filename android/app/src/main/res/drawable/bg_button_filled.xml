<?xml version="1.0" encoding="utf-8"?>
<!--
  Filled button: primary fill, pill, 48dp touch target.

  This is the one button background still in use, because it is the app mark's surface on
  the launcher screen — a plain View, which cannot read a colour role. The screens' buttons
  are MaterialButtons, which draw this shape and this state layer themselves from the
  theme (see bg_button_tonal.xml for the same note on the fallback set).

  The ripple is not decoration: without a state layer a button gives no press feedback at
  all, and a tap reads as "this does nothing" even when the click lands.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/app_state_layer_filled">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/shape_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_primary" />
            <corners android:radius="@dimen/shape_button" />
        </shape>
    </item>
</ripple>

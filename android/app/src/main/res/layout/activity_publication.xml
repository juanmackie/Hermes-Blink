<?xml version="1.0" encoding="utf-8"?>
<!--
  The publication detail view's shell.

  The content of this screen is not a layout: what a publication contains is decided by the
  server (text, an image, a ticker, a question, a list of actions), so the body is built in
  Kotlin and dropped into `publication_content`. The *chrome* is fixed, so it lives here
  and is Material like every other screen: a top app bar that carries the title and a way
  back, and a scrollable body that respects the window insets.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar"
        style="@style/TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/publication_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Pairing: one field, one primary action, and the code's expiry stated plainly. The form
  reads top-down with 16dp gutters, the way the design system's mobile layout does.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <TextView
        style="@style/TextTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pairing_title" />

    <TextView
        style="@style/TextBodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/pairing_explainer" />

    <EditText
        android:id="@+id/pairing_code_input"
        style="@style/TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:autofillHints="off"
        android:hint="@string/pairing_code_hint_short"
        android:inputType="textCapCharacters"
        android:maxLength="32" />

    <TextView
        android:id="@+id/pairing_expiry"
        style="@style/TextBodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textSize="13sp" />

    <Button
        android:id="@+id/pair_btn"
        style="@style/ButtonFilled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/pair" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher surface. Tonal container on the themed canvas, one filled primary action,
  one tonal secondary. Previously this was a white box with black text and no dark mode.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_lg"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_hermes_mono"
        android:background="@drawable/bg_button_filled"
        android:padding="6dp" />

    <TextView
        android:id="@+id/status_text"
        style="@style/TextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/status_disconnected" />

    <TextView
        style="@style/TextBodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/main_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal">

        <Button
            android:id="@+id/connect_btn"
            style="@style/ButtonFilled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect" />

        <Button
            android:id="@+id/diagnostics_btn"
            style="@style/ButtonTonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/delivery_diagnostics" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget picker preview (WD-1 / WD-4): mirrors the composition HermesWidget.kt actually
  ships — header (mark + wordmark + status dot), provenance + hero line, one summary line,
  a body line, and the pinned footer (status line + 48dp MD3 M pill request action).

  The strings are deliberately inlined (android:text, not @string) and the colors come
  from @color/widget_* tokens rather than literals, so:
    * the night variant is the same layout with the -night tokens — no second file to drift;
    * `aapt2 dump xmltree` on the built APK shows the header/action strings, which is how
      the CI check below proves this file still mirrors the widget.

  layout-night/widget_preview.xml exists as the explicit dark twin for launchers that ask
  for a night-specific preview resource; it is generated from this file and must stay in
  sync with it (see scripts/check-contract-parity.py, check "preview").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_background"
    android:padding="12dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hermes_mark"
            app:tint="@color/widget_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.01"
            android:text="Hermes"
            android:textColor="@color/widget_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_status_dot" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="✓ Overnight batch finished"
        android:textColor="@color/widget_on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="Fresh • updated 6 min ago"
        android:textColor="@color/widget_secondary"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:text="142 items triaged, 3 need review before the morning standup."
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Fresh • updated 6 min ago"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action_background"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Request update"
            android:textColor="@color/widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hermes-widget/docs/layout.schema.json",
  "title": "Hermes Widget Layout",
  "description": "v2 contract (reduced). Keep: column,row,box,list,text,divider,spacer,badge,stat,progress,calendar(agenda),button,list_item. Removed: chart,image,icon,toggle,calendar-month,url/deeplink actions. Transport stays /v1/*; layout version is 2. 64KB/100-node caps.",
  "type": "object",
  "required": ["version", "widgetId", "root"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2,
      "description": "Layout contract version (2). Mismatch → device shows upgrade prompt."
    },
    "widgetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable identifier for this widget instance."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of last layout push."
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "description": "Optional widget title."
    },
    "ttlSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400,
      "description": "Cache lifetime hint."
    },
    "accentColor": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "description": "Optional theme accent color (hex only)."
    },
    "root": {
      "$ref": "#/definitions/node",
      "description": "Root node (exactly one)."
    }
  },
  "additionalProperties": false,
  "definitions": {
    "node": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "column", "row", "box", "list",
            "text", "divider", "spacer", "badge",
            "calendar", "stat", "progress",
            "button", "list_item"
          ]
        },
        "id": { "type": "string", "maxLength": 128 },
        "weight": { "type": "number", "minimum": 0 },
        "padding": {
          "type": "object",
          "properties": {
            "top":    { "type": "integer", "minimum": 0 },
            "bottom": { "type": "integer", "minimum": 0 },
            "start":  { "type": "integer", "minimum": 0 },
            "end":    { "type": "integer", "minimum": 0 }
          }
        },
        "visibleIf": {
          "type": "object",
          "description": "FUTURE: device-side conditional rendering not yet implemented."
        },
        "alignment": {
          "type": "string",
          "enum": ["start", "center", "end", "fill"]
        }
      },
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        { "$ref": "#/definitions/nodeSpecifics" }
      ]
    },
    "nodeBase": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "string" },
        "weight": { "type": "number" },
        "padding": { "$ref": "#/definitions/padding" },
        "visibleIf": { "type": "object" },
        "alignment": { "type": "string" }
      }
    },
    "padding": {
      "type": "object",
      "properties": {
        "top":    { "type": "integer", "minimum": 0 },
        "bottom": { "type": "integer", "minimum": 0 },
        "start":  { "type": "integer", "minimum": 0 },
        "end":    { "type": "integer", "minimum": 0 }
      }
    },
    "nodeSpecifics": {
      "oneOf": [
        {
          "if": { "properties": { "type": { "const": "column" } } },
          "then": {
            "properties": {
              "children": {
                "type": "array",
                "items": { "$ref": "#/definitions/node" },
                "minItems": 1,
                "maxItems": 100
              },
              "spacing": { "type": "integer", "minimum": 0, "maximum": 64 },
              "alignment": { "type": "string" }
            },
            "required": ["children"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "row" } } },
          "then": {
            "properties": {
              "children": {
                "type": "array",
                "items": { "$ref": "#/definitions/node" },
                "minItems": 1,
                "maxItems": 20
              },
              "spacing": { "type": "integer", "minimum": 0, "maximum": 64 },
              "alignment": { "type": "string" }
            },
            "required": ["children"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "box" } } },
          "then": {
            "properties": {
              "children": {
                "type": "array",
                "items": { "$ref": "#/definitions/node" },
                "minItems": 1,
                "maxItems": 100
              },
              "alignment": { "type": "string" }
            },
            "required": ["children"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "list" } } },
          "then": {
            "properties": {
              "children": {
                "type": "array",
                "items": { "$ref": "#/definitions/node" },
                "maxItems": 100
              },
              "maxItems": { "type": "integer", "minimum": 1, "maximum": 50 }
            },
            "required": ["children"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 500 },
              "style": {
                "type": "string",
                "enum": ["title", "body", "label", "caption"]
              },
              "maxLines": { "type": "integer", "minimum": 1, "maximum": 50 },
              "color": { "type": "string" },
              "alignment": { "type": "string" }
            },
            "required": ["value"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "divider" } } },
          "then": {
            "properties": {
              "thickness": { "type": "integer", "minimum": 1, "maximum": 16, "default": 1 },
              "color": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "spacer" } } },
          "then": {
            "properties": {
              "size": { "type": "integer", "minimum": 1, "maximum": 256 }
            },
            "required": ["size"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "badge" } } },
          "then": {
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 50 },
              "color": { "type": "string" }
            },
            "required": ["text"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "calendar" } } },
          "then": {
            "properties": {
              "mode": { "type": "string", "enum": ["agenda"] },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["title"],
                  "properties": {
                    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "start": { "type": "string", "format": "date-time" },
                    "end": { "type": "string", "format": "date-time" },
                    "color": { "type": "string" }
                  }
                },
                "maxItems": 50
              },
              "maxItems": { "type": "integer", "minimum": 1, "maximum": 50 }
            },
            "required": ["events"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "stat" } } },
          "then": {
            "properties": {
              "label": { "type": "string", "maxLength": 50 },
              "value": { "type": "string", "minLength": 1, "maxLength": 50 },
              "delta": { "type": "string", "maxLength": 20 },
              "deltaDirection": {
                "type": "string",
                "enum": ["up", "down", "flat"]
              },
              "weight": { "type": "number", "minimum": 0 }
            },
            "required": ["label", "value"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "progress" } } },
          "then": {
            "properties": {
              "value": { "type": "number", "minimum": 0, "maximum": 1 },
              "label": { "type": "string", "maxLength": 50 },
              "showPercent": { "type": "boolean" },
              "max": { "type": "number", "minimum": 1 }
            },
            "required": ["value"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "button" } } },
          "then": {
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "style": {
                "type": "string",
                "enum": ["filled", "tonal", "outlined"]
              },
              "action": { "$ref": "#/definitions/action" }
            },
            "required": ["label"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "list_item" } } },
          "then": {
            "properties": {
              "id": { "type": "string", "maxLength": 128 },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "subtitle": { "type": "string", "maxLength": 200 },
              "leadingIcon": { "type": "string", "maxLength": 50 },
              "trailingText": { "type": "string", "maxLength": 50 },
              "action": { "$ref": "#/definitions/action" }
            },
            "required": ["title"]
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["event", "refresh", "dismiss", "review"]
        },
        "event": { "type": "string", "maxLength": 200 },
        "payload": { "type": "object" },
        "itemId": { "type": "string", "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "event" } } },
          "then": { "required": ["event"] }
        },
        {
          "if": { "properties": { "kind": { "const": "refresh" } } },
          "then": { }
        },
        {
          "if": { "properties": { "kind": { "const": "dismiss" } } },
          "then": { "required": ["itemId"] }
        },
        {
          "if": { "properties": { "kind": { "const": "review" } } },
          "then": { "required": ["itemId"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
